<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBTI로 내 포켓몬 찾기 🐾</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Noto Sans KR & Gowun Dodum for friendly UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Noto+Sans+KR:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cream: '#FFF9E6',
                        warmYellow: '#FFEAA7',
                        accentYellow: '#FDCB6E',
                        deepAmber: '#E17055',
                        charcoal: '#2D3436',
                        softGray: '#636E72',
                        cardBg: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Noto Sans KR', 'sans-serif'],
                        friendly: ['Gowun Dodum', 'sans-serif'],
                    },
                    boxShadow: {
                        'warm-sm': '0 4px 12px rgba(253, 203, 110, 0.2)',
                        'warm-lg': '0 12px 30px rgba(253, 203, 110, 0.35)',
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: #FFF9E6;
            color: #2D3436;
            font-family: 'Noto Sans KR', sans-serif;
            word-break: keep-all;
        }

        /* Smooth tab & card transitions */
        .fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }

        .bounce-hover {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
        }
        
        .bounce-hover:hover {
            transform: translateY(-4px) scale(1.02);
        }

        .bounce-hover:active {
            transform: translateY(0) scale(0.98);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Pokeball pattern background decoration */
        .pokeball-bg {
            background-image: radial-gradient(circle at center, rgba(253, 203, 110, 0.15) 0%, transparent 70%);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased pokeball-bg selection:bg-warmYellow">

    <!-- Navigation / Header -->
    <header class="w-full py-6 px-4 text-center">
        <div class="max-w-xl mx-auto flex items-center justify-center gap-2">
            <span class="text-3xl animate-bounce">⚡</span>
            <h1 class="font-friendly text-2xl sm:text-3xl font-extrabold text-charcoal tracking-tight">
                MBTI로 내 포켓몬 찾기
            </h1>
            <span class="text-3xl">🐾</span>
        </div>
        <p class="text-sm sm:text-base text-softGray mt-2 font-medium">
            나의 성격 유형에 딱 맞는 운명의 포켓몬 친구를 만나보세요!
        </p>
    </header>

    <!-- Main Content Area -->
    <main class="w-full max-w-2xl mx-auto px-4 pb-12 flex-grow flex flex-col justify-center">

        <!-- VIEW 1: MBTI Selection View -->
        <section id="main-view" class="fade-in">
            <!-- Instruction Box -->
            <div class="bg-cardBg rounded-3xl p-6 sm:p-8 shadow-warm-lg border-2 border-warmYellow text-center mb-6">
                <div class="inline-block px-4 py-1.5 bg-warmYellow rounded-full text-xs sm:text-sm font-bold text-amber-900 mb-3">
                    STEP 1. 당신의 MBTI를 선택해 주세요!
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-charcoal mb-1 font-friendly">
                    16가지 유형 중 하나를 클릭하세요
                </h2>
                <p class="text-xs sm:text-sm text-softGray">
                    버튼을 누르면 어울리는 포켓몬과 궁합 정보를 한눈에 확인할 수 있습니다.
                </p>
            </div>

            <!-- MBTI Buttons Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                <!-- Buttons will be injected dynamically or statically defined below for performance -->
                <button onclick="showResult('INTJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">INTJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">용의주도한 전략가</span>
                </button>

                <button onclick="showResult('INTP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">INTP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">논리적인 사색가</span>
                </button>

                <button onclick="showResult('ENTJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ENTJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">대담한 통솔자</span>
                </button>

                <button onclick="showResult('ENTP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ENTP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">뜨거운 혁신가</span>
                </button>

                <button onclick="showResult('INFJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">INFJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">통찰력 있는 예언자</span>
                </button>

                <button onclick="showResult('INFP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">INFP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">열정적인 중재자</span>
                </button>

                <button onclick="showResult('ENFJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ENFJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">정의로운 계도자</span>
                </button>

                <button onclick="showResult('ENFP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ENFP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">재기발랄한 활동가</span>
                </button>

                <button onclick="showResult('ISTJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ISTJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">청렴결백한 현실주의자</span>
                </button>

                <button onclick="showResult('ISFJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ISFJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">용감한 수호자</span>
                </button>

                <button onclick="showResult('ESTJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ESTJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">엄격한 관리자</span>
                </button>

                <button onclick="showResult('ESFJ')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ESFJ</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">사교적인 외교관</span>
                </button>

                <button onclick="showResult('ISTP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ISTP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">만능 재주꾼</span>
                </button>

                <button onclick="showResult('ISFP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ISFP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">호기심 많은 예술가</span>
                </button>

                <button onclick="showResult('ESTP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ESTP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">모험을 즐기는 모험가</span>
                </button>

                <button onclick="showResult('ESFP')" class="bounce-hover bg-cardBg border-2 border-amber-200 hover:border-accentYellow p-4 rounded-2xl text-center shadow-warm-sm group">
                    <span class="block text-xl font-black text-amber-800 group-hover:text-accentYellow transition-colors">ESFP</span>
                    <span class="text-xs font-semibold text-softGray mt-1 block">자유로운 연예인</span>
                </button>
            </div>
        </section>

        <!-- VIEW 2: Result Display View (Initially Hidden) -->
        <section id="result-view" class="hidden">
            <div id="result-card" class="bg-cardBg rounded-3xl p-6 sm:p-8 shadow-warm-lg border-2 border-warmYellow text-center relative overflow-hidden">
                
                <!-- MBTI Badge Tag -->
                <div class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-amber-100 rounded-full text-sm font-extrabold text-amber-900 mb-4 border border-amber-200">
                    <span id="res-mbti">INFP</span> <span class="text-xs text-amber-700">유형의 포켓몬</span>
                </div>

                <!-- Pokémon Emoji & Character Display -->
                <div class="relative my-2">
                    <div class="w-32 h-32 sm:w-40 sm:h-40 mx-auto bg-gradient-to-b from-warmYellow to-amber-100 rounded-full flex items-center justify-center text-7xl sm:text-8xl shadow-inner border-4 border-white">
                        <span id="res-emoji">🎀</span>
                    </div>
                </div>

                <!-- Pokémon Name & Title -->
                <h2 class="text-2xl sm:text-3xl font-black text-charcoal mt-4 font-friendly">
                    <span id="res-name">님피아</span>
                </h2>
                <p id="res-subtitle" class="text-sm font-semibold text-amber-700 mb-6">
                    따뜻한 감성으로 마음을 잇는 낭만파
                </p>

                <!-- Match Reason (2~3 lines) -->
                <div class="bg-cream rounded-2xl p-4 sm:p-5 text-left mb-6 border border-amber-100 shadow-sm">
                    <h3 class="text-xs font-bold text-amber-800 uppercase tracking-wider mb-2 flex items-center gap-1">
                        <i class="fa-solid fa-heart text-amber-500"></i> 어울리는 이유
                    </h3>
                    <p id="res-reason" class="text-sm sm:text-base text-charcoal leading-relaxed font-normal">
                        섬세한 감수성과 다정한 마음으로 주변을 밝혀주는 당신은 님피아와 꼭 닮았습니다! 타인의 마음을 깊게 공감하며, 상처받은 마음도 포근하게 안아줄 수 있는 특별한 따뜻함을 지니고 있습니다.
                    </p>
                    
                    <!-- Trait Hashtags -->
                    <div id="res-tags" class="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-amber-200/50">
                        <span class="text-xs font-semibold px-2.5 py-1 bg-white rounded-md text-amber-800 border border-amber-200">#공감왕</span>
                        <span class="text-xs font-semibold px-2.5 py-1 bg-white rounded-md text-amber-800 border border-amber-200">#낭만파</span>
                        <span class="text-xs font-semibold px-2.5 py-1 bg-white rounded-md text-amber-800 border border-amber-200">#따뜻한마음</span>
                    </div>
                </div>

                <!-- Best Match Chemistry Box -->
                <div class="bg-amber-50 rounded-2xl p-4 border border-amber-200 mb-8 flex items-center justify-between">
                    <div class="text-left">
                        <span class="text-xs font-bold text-amber-800 block"> 최고의 찰떡궁합 포켓몬</span>
                        <span id="res-chem-text" class="text-sm sm:text-base font-bold text-charcoal">
                            ENTJ - 윈디 🦁
                        </span>
                    </div>
                    <div class="text-2xl sm:text-3xl bg-white p-2 rounded-xl shadow-xs border border-amber-100" id="res-chem-emoji">
                        🦁
                    </div>
                </div>

                <!-- Action Buttons Grid -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <button onclick="resetView()" class="bounce-hover flex-1 py-3.5 px-5 bg-warmYellow hover:bg-accentYellow text-amber-950 font-bold rounded-2xl shadow-warm-sm flex items-center justify-center gap-2 text-base transition-colors">
                        <i class="fa-solid fa-rotate-right"></i> 다시 고르기
                    </button>
                    <button onclick="copyShareLink()" class="bounce-hover flex-1 py-3.5 px-5 bg-charcoal hover:bg-slate-800 text-white font-bold rounded-2xl shadow-warm-sm flex items-center justify-center gap-2 text-base transition-colors">
                        <i class="fa-solid fa-share-nodes"></i> 결과 공유하기
                    </button>
                </div>

            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="w-full py-4 text-center text-xs text-softGray border-t border-amber-200/50">
        <p>© MBTI Pokémon Matcher • 모든 포켓몬 권리는 Nintendo / Pokémon Company에 있습니다.</p>
    </footer>

    <!-- Toast Notification (Replaces Alert) -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-charcoal text-white px-5 py-3 rounded-full shadow-lg text-sm font-medium opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2 z-50">
        <i class="fa-solid fa-circle-check text-green-400"></i>
        <span id="toast-message">결과가 클립보드에 복사되었습니다!</span>
    </div>

    <script>
        // 16 MBTI Pokémon Database Definition
        const pokemonData = {
            'INTJ': {
                name: '뮤츠',
                emoji: '🧠',
                subtitle: '치밀하고 철저한 용의주도 전략가',
                reason: '비범한 지성과 치밀한 계획으로 세상을 분석하는 고독한 완벽주의 포켓몬입니다. 감정에 휘둘리지 않고 문제의 본질을 정확히 뚫어보는 높은 통찰력을 가지고 있습니다.',
                tags: ['#전략가', '#독립적', '#통찰력'],
                chemistry: { mbti: 'ENFP', name: '피카츄', emoji: '⚡' }
            },
            'INTP': {
                name: '후딘',
                emoji: '🥄',
                subtitle: '끝없는 호기심을 지닌 아이디어 소유자',
                reason: '새로운 이론과 지식을 탐구하는 데 깊이 몰입하는 지능형 포켓몬입니다. 논리적이고 호기심이 많아 어떤 어려운 문제라도 나만의 창의적인 방식으로 해결해 냅니다.',
                tags: ['#호기심', '#논리왕', '#사색가'],
                chemistry: { mbti: 'ENFJ', name: '토게키스', emoji: '🕊️' }
            },
            'ENTJ': {
                name: '윈디',
                emoji: '🦁',
                subtitle: '위풍당당하고 카리스마 넘치는 리더',
                reason: '당당한 기상과 압도적인 통솔력으로 무리를 이끄는 지도자 포켓몬입니다. 명확한 목표를 설정하고 망설임 없는 실행력으로 단숨에 목표를 이뤄냅니다.',
                tags: ['#카리스마', '#추진력', '#리더십'],
                chemistry: { mbti: 'INFP', name: '님피아', emoji: '🎀' }
            },
            'ENTP': {
                name: '로토무',
                emoji: '🛸',
                subtitle: '기발한 아이디어가 넘쳐나는 뜨거운 혁신가',
                reason: '어디로 튈지 모르는 톡톡 튀는 장난기와 재치로 가득한 발명가 포켓몬입니다. 고정관념에 얽매이지 않고 세상을 새로운 시각으로 변화시키는 걸 즐깁니다.',
                tags: ['#아이디어', '#재치만점', '#혁신가'],
                chemistry: { mbti: 'INFJ', name: '루기아', emoji: '🌊' }
            },
            'INFJ': {
                name: '루기아',
                emoji: '🌊',
                subtitle: '깊은 통찰력과 따뜻한 신념의 수호자',
                reason: '고요하지만 강력한 마음의 힘으로 사람들을 지키는 신비로운 수호자 포켓몬입니다. 조용히 주변을 살피며 타인의 상처를 헤아리는 깊은 혜안을 가지고 있습니다.',
                tags: ['#신념', '#통찰력', '#따뜻한수호자'],
                chemistry: { mbti: 'ENTP', name: '로토무', emoji: '🛸' }
            },
            'INFP': {
                name: '님피아',
                emoji: '🎀',
                subtitle: '섬세한 감성으로 마음을 잇는 낭만파',
                reason: '섬세한 감수성과 다정한 마음으로 주변에 사랑과 평화를 전하는 포켓몬입니다. 겉은 상스롭고 포근하지만, 자신이 지키고자 하는 가치 앞에서는 강한 신념을 발휘합니다.',
                tags: ['#공감왕', '#낭만파', '#순수한마음'],
                chemistry: { mbti: 'ENTJ', name: '윈디', emoji: '🦁' }
            },
            'ENFJ': {
                name: '토게키스',
                emoji: '🕊️',
                subtitle: '온기와 기쁨을 나누는 정의로운 조력자',
                reason: '사람들에게 행복을 전파하며 따뜻하게 무리를 아우르는 분위기 리더 포켓몬입니다. 타인의 성장을 진심으로 기뻐하며 항상 긍정적인 에너지를 보냅니다.',
                tags: ['#행복전파', '#포용력', '#다정한리더'],
                chemistry: { mbti: 'INTP', name: '후딘', emoji: '🥄' }
            },
            'ENFP': {
                name: '피카츄',
                emoji: '⚡',
                subtitle: '모두를 미소 짓게 만드는 재기발랄 비타민',
                reason: '밝은 호기심과 친근한 에너지로 누구와도 빠르게 친해지는 인싸 포켓몬입니다. 함께 있는 것만으로도 주위를 환하게 밝히는 당찬 매력을 자랑합니다.',
                tags: ['#에너지', '#인기쟁이', '#호기심'],
                chemistry: { mbti: 'INTJ', name: '뮤츠', emoji: '🧠' }
            },
            'ISTJ': {
                name: '거북왕',
                emoji: '🐢',
                subtitle: '묵묵하고 든든하게 책임을 다하는 방어의 아이콘',
                reason: '한번 맡은 일은 끝까지 완벽하고 철저하게 해내는 신뢰의 포켓몬입니다. 흔들리지 않는 묵직함과 단단함으로 친구들에게 가장 의지되는 든든한 버팀목입니다.',
                tags: ['#책임감', '#원칙주의', '#신뢰성'],
                chemistry: { mbti: 'ESFP', name: '푸린', emoji: '🎤' }
            },
            'ISFJ': {
