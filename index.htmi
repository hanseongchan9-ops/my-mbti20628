                subtitle: '어디서나 분위기를 밝히는 연예인',
                reason: '화려한 흥과 스타성으로 가는 곳마다 무대의 주인공이 되는 분위기 메이커 포켓몬입니다. 주변 사람들에게 즐거움과 웃음을 선사하는 활력소입니다.',
                tags: ['#분위기메이커', '#흥부자', '#자유로운영혼'],
                chemistry: { mbti: 'ISTJ', name: '거북왕', emoji: '🐢' }
            }
        };

        // Current state variable
        let currentMBTI = '';

        /**
         * Render result view based on chosen MBTI
         */
        function showResult(mbti) {
            const data = pokemonData[mbti];
            if (!data) return;

            currentMBTI = mbti;

            // Fill elements with data
            document.getElementById('res-mbti').innerText = mbti;
            document.getElementById('res-emoji').innerText = data.emoji;
            document.getElementById('res-name').innerText = data.name;
            document.getElementById('res-subtitle').innerText = data.subtitle;
            document.getElementById('res-reason').innerText = data.reason;
            
            // Render Hashtags
            const tagsContainer = document.getElementById('res-tags');
            tagsContainer.innerHTML = data.tags.map(tag => 
                `<span class="text-xs font-semibold px-2.5 py-1 bg-white rounded-md text-amber-800 border border-amber-200">${tag}</span>`
            ).join('');

            // Render Chemistry
            document.getElementById('res-chem-text').innerText = `${data.chemistry.mbti} - ${data.chemistry.name} ${data.chemistry.emoji}`;
            document.getElementById('res-chem-emoji').innerText = data.chemistry.emoji;

            // View toggle with animation
            const mainView = document.getElementById('main-view');
            const resultView = document.getElementById('result-view');

            mainView.classList.add('hidden');
            resultView.classList.remove('hidden');
            resultView.classList.add('fade-in');

            // Scroll smoothly to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /**
         * Reset back to main screen
         */
        function resetView() {
            const mainView = document.getElementById('main-view');
            const resultView = document.getElementById('result-view');

            resultView.classList.add('hidden');
            resultView.classList.remove('fade-in');

            mainView.classList.remove('hidden');
            mainView.classList.add('fade-in');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /**
         * Copy share text to clipboard (safely without standard alert)
         */
        function copyShareLink() {
            if (!currentMBTI) return;
            const data = pokemonData[currentMBTI];
            const textToCopy = `[MBTI로 내 포켓몬 찾기]\n나의 MBTI(${currentMBTI})에 어울리는 포켓몬은 "${data.emoji} ${data.name}"입니다!\n함께 어울리는 포켓몬을 찾아보세요! 🐾`;

            // Fallback execCommand method for iframe security constraints
            const dummy = document.createElement("textarea");
            document.body.appendChild(dummy);
            dummy.value = textToCopy;
            dummy.select();
            document.execCommand("copy");
            document.body.removeChild(dummy);

            // Show custom toast UI
            showToast(`[${data.name}] 결과가 클립보드에 복사되었습니다!`);
        }

        /**
         * Show custom notification toast
         */
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            
            toastMessage.innerText = message;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }
    </script>
</body>
</html>
